# .env.local.example — copy to .env.local for local-install.sh.
# All values are OPTIONAL — local-mode runs with zero secrets configured;
# unset providers just unavailable until you fill them in.

# ── Compose port overrides ──────────────────────────────────────────────────
# Defaults: 3000 / 5433 / 11434. Override if those clash.
# NEXUS_PORT=3000
# POSTGRES_PORT=5433
# OLLAMA_PORT=11434

# ── Default Ollama model pulled on first install ────────────────────────────
# llama3.3:latest is ~40GB. Use a smaller variant for first-time tests:
#   NEXUS_OLLAMA_MODEL=qwen2.5:7b
# NEXUS_OLLAMA_MODEL=llama3.3:latest

# ── LLM provider — defaults to Ollama for local. Switch to claude / openrouter
# when you want cloud quality on a local stack. Single env var, code routes
# automatically (lib/llm/provider.ts).
# LLM_PROVIDER=ollama
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Supabase (optional — local stack uses local Postgres by default) ────────
# If you want to share data with the Coolify cloud install, set these to
# the same values that deployment uses. Otherwise leave blank.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
