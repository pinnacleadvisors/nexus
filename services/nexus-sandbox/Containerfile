# Nexus sandbox — rootless Podman in a container, exposed via HTTP.
#
# Used by the `skill-trainer` agent (and any future "execute untrusted code"
# loop) to run ephemeral scripts in isolation. Base image is the upstream
# `quay.io/podman/stable` which is pre-configured for nested rootless Podman
# on Fedora — saves us the slirp4netns / subuid / subgid setup dance.
#
# Compose runs this with `privileged: true` because nested Podman needs
# CAP_SYS_ADMIN to set up user namespaces. Acceptable for lean mode (one
# tenant, owner-trusted). Document the trade-off in README.md.

FROM quay.io/podman/stable:latest

# Node.js + curl (needed by the Doppler install script). Fedora base = dnf.
RUN dnf install -y --setopt=install_weak_deps=False nodejs curl \
 && dnf clean all

# Doppler CLI — fetches secrets at container start, so the only env Coolify
# needs is DOPPLER_TOKEN. See docs/runbooks/doppler-coolify-sync.md.
RUN curl -Ls --tlsv1.2 --proto "=https" --retry 3 https://cli.doppler.com/install.sh | sh

WORKDIR /app
COPY server.mjs ./

EXPOSE 8080

# Run as the pre-configured `podman` user (UID 1000) from the base image.
# Rootless Podman works out of the box for this user; switching to root
# would defeat the purpose.
USER podman

# Doppler-wrapped — NEXUS_SANDBOX_TOKEN + any other config arrive via Doppler.
CMD ["doppler", "run", "--fallback=/tmp/doppler.cache.json", "--", "node", "server.mjs"]
