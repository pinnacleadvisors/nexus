<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference copy. INSTALL to ~/Library/LaunchAgents/ and load with:
       cp services/local-os/com.nexus.local-os.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nexus.local-os.plist
     Brings the local-OS stack up at login (paired with OrbStack
     app.start_at_login=true). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nexus.local-os</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/dylan_mini/Dev/nexus/services/local-os/startup.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/dylan_mini/Dev/nexus/services/local-os/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dylan_mini/Dev/nexus/services/local-os/launchd.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
