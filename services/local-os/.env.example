# Copy to .env (gitignored) and fill with a Doppler SERVICE TOKEN for nexus/prd.
# Mint one with:
#   doppler configs tokens create local-os-mac --project nexus --config prd --plain
# The containers' ENTRYPOINT runs `doppler run --` with this token to pull every
# other secret at boot. This is the ONLY secret stored on the Mac, mirroring the
# single-DOPPLER_TOKEN Coolify pattern (see AGENTS.md "Docker images ... Doppler").
DOPPLER_TOKEN=REPLACE_WITH_DOPPLER_PRD_SERVICE_TOKEN
