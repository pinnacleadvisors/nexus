{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:retry-storm": "node scripts/check-retry-storm.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "check:sentry-config": "node scripts/check-sentry-config.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:topology": "node scripts/check-topology.mjs",
    "check:agent-spec-freshness": "node scripts/check-agent-spec-freshness.mjs",
    "check:provider-agnostic": "node scripts/check-provider-agnostic.mjs",
    "seed:deferred-tasks": "doppler run -- node scripts/seed-deferred-tasks.mjs",
    "check:all": "npm run lint && npx tsc --noEmit && npm run check:retry-storm && npm run check:sentry-config && npm run check:lockfile && npm run check:topology && npm run check:agent-spec-freshness && npm run check:provider-agnostic",
    "migrate": "doppler run -- node scripts/migrate.mjs",
    "migrate:local": "node scripts/migrate.mjs",
    "types:regen": "doppler run -- node scripts/regenerate-database-types.mjs",
    "types:regen:local": "node scripts/regenerate-database-types.mjs",
    "diagnose:codex": "doppler run -- node scripts/diagnose-codex-gateway.mjs",
    "diagnose:codex:local": "node scripts/diagnose-codex-gateway.mjs",
    "repair:codex": "doppler run -- node scripts/repair-codex-gateway-routing.mjs",
    "repair:codex:local": "node scripts/repair-codex-gateway-routing.mjs",
    "migrate:tunnel": "doppler run -- node scripts/migrate-tunnel-hostname.mjs",
    "migrate:tunnel:local": "node scripts/migrate-tunnel-hostname.mjs",
    "populate-memory": "doppler run -- node scripts/populate-memory.mjs",
    "populate-memory:local": "node scripts/populate-memory.mjs",
    "deploy": "doppler run -- ./scripts/deploy.sh",
    "deploy:local": "./scripts/deploy.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.66",
    "@ai-sdk/openai": "^3.0.50",
    "@ai-sdk/react": "^3.0.151",
    "@aws-sdk/client-s3": "^3.1028.0",
    "@aws-sdk/s3-request-presigner": "^3.1028.0",
