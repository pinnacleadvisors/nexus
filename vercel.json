{
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/signal-review",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/rebuild-graph-hq",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/sync-memory?reconcile=1",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/post-deploy-smoke",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/sync-learning-cards",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/sweep-orphan-cards",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/audit-prune",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/scale-down-businesses",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/simulation-tick",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/solopreneur-tick",
      "schedule": "0 9,12,15,21 * * *"
    },
    {
      "path": "/api/cron/codex-maintainer-tick",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/optimizer-scan-failures",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/simulation-benchmark",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/platform-dev-tick",
      "schedule": "*/30 * * * *"
    }
  ],
  "experimentalServices": {
    "frontend": {
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "claude-gateway": {
      "entrypoint": "services/claude-gateway",
      "routePrefix": "/_/claude-gateway"
    },
    "codex-gateway": {
      "entrypoint": "services/codex-gateway",
      "routePrefix": "/_/codex-gateway"
    },
    "qa-runner": {
      "entrypoint": "services/qa-runner",
      "routePrefix": "/_/qa-runner"
    }
  }
}
